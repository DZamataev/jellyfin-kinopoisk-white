{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "options": {
                "cwd": "${userHome}"
            },
            "args": [
                "build",
                "${workspaceFolder}/${workspaceFolderBasename}.csproj",
                "--no-restore",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false,
                "panel": "dedicated",
                "reveal": "never",
                "revealProblems": "onProblem",
                "clear": true,
                "close": true,
            }
        },
        {
            "label": "install",
            "command": "cp",
            "type": "shell",
            "options": { "cwd": "${userHome}" },
            "args": [
                "${workspaceFolder}/bin/Debug/net8.0/${workspaceFolderBasename}.dll",
                "/output/${workspaceFolderBasename}"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "showReuseMessage": false,
                "clear": true,
                "close": true,
            }
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "options": { "cwd": "${userHome}" },
            "args": [
                "watch",
                "--no-hot-reload",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary",
                "build",
                "--project",
                "${workspaceFolder}/${workspaceFolderBasename}.csproj",
                "--no-restore"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "reveal": "silent"
            },
            "runOptions": {
                "runOn": "folderOpen"
            }
        }
    ]
}
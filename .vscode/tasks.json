{
    "version": "2.0.0",
    "options": {

    },
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "options": {
                "cwd": "${userHome}",
            },
            "args": [
                "build",
                "${workspaceFolder}/Plugin/Plugin.csproj",
                "--no-restore",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$msCompile",
            "presentation": {
                "echo": false,
                "showReuseMessage": false,
                "panel": "dedicated",
                "reveal": "never",
                "revealProblems": "onProblem",
            }
        },
        {
            "label": "install",
            "command": "mkdir -p ${outputDir} && cp ${pluginDll} ${outputDir}",
            "type": "shell",
            "options": {
                "cwd": "${userHome}",
                "env": {
                    "pluginDll": "${workspaceFolder}/Plugin/bin/Debug/net8.0/Jellyfin.Plugin.KinopoiskWhite.dll",
                    "outputDir": "/output/Jellyfin.Plugin.KinopoiskWhite",
                },
            },
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "showReuseMessage": false,
            }
        },
        {
            "label": "test",
            "command": "dotnet",
            "type": "process",
            "options": {
                "cwd": "${userHome}",
            },
            "args": [
                "test",
                "${workspaceFolder}/Test/Test.csproj",
                "--no-restore",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "echo": false,
                "showReuseMessage": false,
                "panel": "dedicated",
                "reveal": "silent",
                "revealProblems": "never",
            }
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "options": { "cwd": "${userHome}" },
            "args": [
                "watch",
                "--no-hot-reload",
                "-property:GenerateFullPaths=true",
                "-consoleloggerparameters:NoSummary",
                "build",
                "--project",
                "${workspaceFolder}/Plugin/Plugin.csproj",
                "--no-restore"
            ],
            "presentation": {
                "echo": false,
                "reveal": "silent"
            },
            // "runOptions": { "runOn": "folderOpen" }
        }
    ]
}